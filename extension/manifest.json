{
  "manifest_version": 3,
  "name": "Media Tray Bridge",
  "version": "1.0.0",
  "key": "",
  "permissions": ["tabs"],
  "host_permissions": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Media Tray — klik untuk reset volume tab ini ke 100%" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/core.js", "content/youtube.js", "content/media.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["lib/core.js", "content/ytmusic.js", "content/media.js"],
      "run_at": "document_idle"
    }
  ]
}
