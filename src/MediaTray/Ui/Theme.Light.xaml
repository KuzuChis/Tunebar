<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors for Windows light mode. The accent brush is added in code (Theme.cs). -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F9F9F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D5D5D5" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TrackBrush" Color="#C8C8C8" />
</ResourceDictionary>
