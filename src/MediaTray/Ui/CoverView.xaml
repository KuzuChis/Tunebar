<UserControl x:Class="MediaTray.Ui.CoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MediaTray.Ui"
             x:Name="Root">
    <!-- A rounded cover picture. Without a picture you see the surface color and a music note. -->
    <Grid>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{Binding CornerRadius, ElementName=Root}">
            <TextBlock Style="{StaticResource IconText}"
                       FontSize="{Binding GlyphSize, ElementName=Root}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="{x:Static ui:Glyphs.Music}" />
        </Border>
        <Border CornerRadius="{Binding CornerRadius, ElementName=Root}">
            <Border.Background>
                <ImageBrush Stretch="UniformToFill"
                            ImageSource="{Binding Item, ElementName=Root, Converter={StaticResource CoverConverter}}" />
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
