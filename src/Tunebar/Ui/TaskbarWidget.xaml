<UserControl x:Class="Tunebar.Ui.TaskbarWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Tunebar.Ui"
             FontFamily="{StaticResource TextFont}" FontSize="12"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Cover and text: looks like a taskbar button (6px corner, faint highlight on hover). -->
        <Style x:Key="WidgetOpenButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,4,8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WidgetHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The near-invisible background makes the whole widget hit-testable. -->
    <Grid Background="#01000000">

        <!-- Nothing is playing: dim -->
        <Button Style="{StaticResource WidgetOpenButton}" VerticalAlignment="Center"
                Click="OnOpenClick"
                Visibility="{Binding HasCurrent, Converter={StaticResource InvertedBoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" FontSize="16"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{x:Static ui:Glyphs.Music}" />
                <TextBlock Style="{StaticResource TertiaryText}" Margin="8,0,0,0" FontSize="12"
                           VerticalAlignment="Center" Text="Tidak ada yang diputar" />
            </StackPanel>
        </Button>

        <!-- Something is playing: cover + title/artist on the left, three buttons on the right -->
        <DockPanel VerticalAlignment="Center"
                   Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}">

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                <Button Style="{StaticResource IconButton}" ToolTip="Sebelumnya"
                        IsEnabled="{Binding Current.CanPrev}" Click="OnPrevClick">
                    <TextBlock Style="{StaticResource IconText}" FontSize="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{x:Static ui:Glyphs.Previous}" />
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="Putar / jeda" Click="OnPlayPauseClick">
                    <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{Binding PlayPauseGlyph}" />
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="Berikutnya"
                        IsEnabled="{Binding Current.CanNext}" Click="OnNextClick">
                    <TextBlock Style="{StaticResource IconText}" FontSize="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{x:Static ui:Glyphs.Next}" />
                </Button>
            </StackPanel>

            <Button Style="{StaticResource WidgetOpenButton}" Click="OnOpenClick">
                <DockPanel>
                    <ui:CoverView DockPanel.Dock="Left" Width="32" Height="32"
                                  CornerRadius="4" GlyphSize="16" Item="{Binding Current}" />
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" FontSize="10"
                                       Margin="4,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{x:Static ui:Glyphs.Lock}"
                                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Text="{Binding Current.Title}" />
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="{Binding FlashText}"
                                   Visibility="{Binding IsFlashing, Converter={StaticResource BoolToVis}}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="{Binding Current.Artist}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current.Artist}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current.Artist}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Button>
        </DockPanel>
    </Grid>
</UserControl>
